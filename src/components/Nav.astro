---
import site from '../data/site.json';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label={`${site.brand} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">{site.brand}</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <a class="btn btn-primary nav-cta" href={`mailto:${site.email}`}>Hire me</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="sr-only">Menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    {
      links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))
    }
    <a class="btn btn-primary" href={`mailto:${site.email}`}>Hire me</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    background: linear-gradient(to bottom, rgba(7, 7, 8, 0.88), rgba(7, 7, 8, 0.42), transparent);
    backdrop-filter: blur(10px);
    transition: border-color 0.35s var(--ease), background 0.35s var(--ease);
  }

  .nav.is-scrolled {
    border-bottom-color: var(--line);
    background: rgba(7, 7, 8, 0.9);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 55%, 55% 55%, 55% 100%, 0 100%);
  }

  .nav-links {
    display: none;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.92rem;
    transition: color 0.25s var(--ease);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-cta {
    display: none;
  }

  .nav-toggle {
    justify-self: end;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: transparent;
    display: grid;
    place-content: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .nav-toggle span:not(.sr-only) {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--ink);
  }

  .mobile-nav {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.25rem 1.4rem;
    background: rgba(7, 7, 8, 0.96);
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav a:not(.btn) {
    padding: 0.85rem 0.35rem;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav .btn {
    margin-top: 0.75rem;
  }

  @media (min-width: 860px) {
    .nav-inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .nav-links {
      display: flex;
    }

    .nav-cta {
      display: inline-flex;
      justify-self: end;
    }

    .nav-toggle,
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector('.nav');
  const toggle = document.querySelector('.nav-toggle');
  const mobile = document.querySelector('#mobile-nav');

  const onScroll = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    mobile?.toggleAttribute('hidden', open);
  });

  mobile?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('hidden', '');
    });
  });
</script>
