---
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <a class="footer-brand" href="#top">{site.brand}</a>
    <p>© {year} {site.name}. Edited for {site.domain}.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 1.75rem 2.25rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .footer p {
    margin: 0;
    color: var(--faint);
    font-size: 0.88rem;
  }
</style>
